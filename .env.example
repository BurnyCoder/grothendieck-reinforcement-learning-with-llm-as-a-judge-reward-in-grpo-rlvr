# Copy to .env inside the project; these paths are for WSL.
GROTH_ROOT=/mnt/d/AI/grothendieck-rlvr
# Optional project-specific native WSL venv if Windows-mounted imports are slow:
# UV_PROJECT_ENVIRONMENT=/home/your-user/projects/grothendieck-rlvr-runtime/.venv
HF_HOME=/mnt/d/AI/grothendieck-rlvr/huggingface
UV_CACHE_DIR=/mnt/d/AI/grothendieck-rlvr/uv-cache-linux
TORCHINDUCTOR_CACHE_DIR=/mnt/d/AI/grothendieck-rlvr/torch-cache
TRITON_CACHE_DIR=/mnt/d/AI/grothendieck-rlvr/triton-cache
UNSLOTH_COMPILE_LOCATION=/mnt/d/AI/grothendieck-rlvr/unsloth-cache
PYTHONHASHSEED=0
TOKENIZERS_PARALLELISM=false
GROTH_JUDGE_URL=http://127.0.0.1:8081
GROTH_EVAL_URL=http://127.0.0.1:8082
# Optional binary locations; runtime settings still come from configs/judge-runtime.json.
# LLAMA_SERVER_CPU=/mnt/d/AI/grothendieck-rlvr/tools/llama.cpp/build/bin/llama-server
# LLAMA_SERVER_CUDA=/mnt/d/AI/grothendieck-rlvr/tools/llama-b12359-cuda12/bin/llama-server
