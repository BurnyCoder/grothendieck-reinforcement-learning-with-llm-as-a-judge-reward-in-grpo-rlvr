char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
criteria ::= "{" space criteria-structural-understanding-kv "," space criteria-justified-generality-kv "," space criteria-problem-as-consequence-kv "," space criteria-reuse-and-connections-kv "," space criteria-conceptual-economy-kv "," space criteria-constructive-novelty-kv space "}"
criteria-conceptual-economy ::= ref-defs-Criterion
criteria-conceptual-economy-kv ::= "\"conceptual_economy\"" space ":" space criteria-conceptual-economy
criteria-constructive-novelty ::= ref-defs-Criterion
criteria-constructive-novelty-kv ::= "\"constructive_novelty\"" space ":" space criteria-constructive-novelty
criteria-justified-generality ::= ref-defs-Criterion
criteria-justified-generality-kv ::= "\"justified_generality\"" space ":" space criteria-justified-generality
criteria-kv ::= "\"criteria\"" space ":" space criteria
criteria-problem-as-consequence ::= ref-defs-Criterion
criteria-problem-as-consequence-kv ::= "\"problem_as_consequence\"" space ":" space criteria-problem-as-consequence
criteria-reuse-and-connections ::= ref-defs-Criterion
criteria-reuse-and-connections-kv ::= "\"reuse_and_connections\"" space ":" space criteria-reuse-and-connections
criteria-structural-understanding ::= ref-defs-Criterion
criteria-structural-understanding-kv ::= "\"structural_understanding\"" space ":" space criteria-structural-understanding
novelty-comparison ::= ref-defs-NoveltyComparison
novelty-comparison-kv ::= "\"novelty_comparison\"" space ":" space novelty-comparison
problems ::= "[" space (problems-item ("," space problems-item){0,7})? space "]"
problems-item ::= "\"" char{0,160} "\""
problems-kv ::= "\"problems\"" space ":" space problems
ref-defs-Criterion ::= "{" space ref-defs-Criterion-evidence-kv "," space ref-defs-Criterion-rationale-kv "," space ref-defs-Criterion-score-kv space "}"
ref-defs-Criterion-evidence ::= "[" space (ref-defs-Criterion-evidence-item ("," space ref-defs-Criterion-evidence-item){0,2})? space "]"
ref-defs-Criterion-evidence-item ::= ("\"C0\"" | "\"C1\"")
ref-defs-Criterion-evidence-kv ::= "\"evidence\"" space ":" space ref-defs-Criterion-evidence
ref-defs-Criterion-rationale ::= "\"" char{0,240} "\""
ref-defs-Criterion-rationale-kv ::= "\"rationale\"" space ":" space ref-defs-Criterion-rationale
ref-defs-Criterion-score ::= ([0-4])
ref-defs-Criterion-score-kv ::= "\"score\"" space ":" space ref-defs-Criterion-score
ref-defs-NoveltyComparison ::= "{" space ref-defs-NoveltyComparison-reference-excerpt-kv "," space ref-defs-NoveltyComparison-addition-evidence-kv "," space ref-defs-NoveltyComparison-use-evidence-kv "," space ref-defs-NoveltyComparison-relation-kv space "}"
ref-defs-NoveltyComparison-addition-evidence ::= "[" space (ref-defs-NoveltyComparison-addition-evidence-item ("," space ref-defs-NoveltyComparison-addition-evidence-item){0,2})? space "]"
ref-defs-NoveltyComparison-addition-evidence-item ::= ("\"C0\"" | "\"C1\"")
ref-defs-NoveltyComparison-addition-evidence-kv ::= "\"addition_evidence\"" space ":" space ref-defs-NoveltyComparison-addition-evidence
ref-defs-NoveltyComparison-reference-excerpt ::= ("\"R0\"")
ref-defs-NoveltyComparison-reference-excerpt-kv ::= "\"reference_excerpt\"" space ":" space ref-defs-NoveltyComparison-reference-excerpt
ref-defs-NoveltyComparison-relation ::= ("\"within_reference\"" | "\"beyond_reference\"" | "\"unresolved\"")
ref-defs-NoveltyComparison-relation-kv ::= "\"relation\"" space ":" space ref-defs-NoveltyComparison-relation
ref-defs-NoveltyComparison-use-evidence ::= "[" space (ref-defs-NoveltyComparison-use-evidence-item ("," space ref-defs-NoveltyComparison-use-evidence-item){0,2})? space "]"
ref-defs-NoveltyComparison-use-evidence-item ::= ("\"C0\"" | "\"C1\"")
ref-defs-NoveltyComparison-use-evidence-kv ::= "\"use_evidence\"" space ":" space ref-defs-NoveltyComparison-use-evidence
root ::= "{" space theory-validity-kv "," space novelty-comparison-kv "," space criteria-kv "," space problems-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
theory-validity ::= ("\"none\"" | "\"supported\"" | "\"unsupported\"" | "\"contradicted\"")
theory-validity-kv ::= "\"theory_validity\"" space ":" space theory-validity
